# Copy to `.env` (gitignored) and fill in. Real environment variables win over this file.
# Never commit real values — both of these are secrets.

# Mapillary client token, from https://www.mapillary.com/dashboard/developers.
# Required by `main.py --source mapillary`; unused for GSV runs.
MAPILLARY_ACCESS_TOKEN=

# Project Sidewalk's shared internal API key — the value of INTERNAL_API_KEY on the
# target instance, obtained from that server's maintainers. `send_to_ps.py` sends it as
# an `Authorization: Bearer` header; without it the ingest endpoint returns 401.
# It is per-instance, so a key for one city's server will not authenticate to another's.
# With a key set, `send_to_ps.py` refuses a non-https remote --endpoint.
PS_INTERNAL_API_KEY=
