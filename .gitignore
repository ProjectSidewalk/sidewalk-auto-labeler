cache
__pycache__
.venv
.vscode/
# Local secrets (MAPILLARY_ACCESS_TOKEN, PS_INTERNAL_API_KEY) — never commit.
.env
*.jsonl
*.submitted
nohup.out
smoke_check

# Run directories: track only the small, high-value files (provenance + hand-labeled
# verdicts); results and resume caches stay local.
runs/**
!runs/*/
!runs/*/manifest.json
!runs/*/area.geojson
!runs/*/*_verdicts.json
!runs/*/*.submission.json
# Position check (scripts/position_check.py): the verdict and its self-contained report
# stay with the run's provenance; the Overpass cache beside them does not.
!runs/*/position_check.json
!runs/*/position_report.html
